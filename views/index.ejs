<!DOCTYPE html>

<html>
    <head>
        <title>Members Only</title>
        <link href="/styles.css" rel="stylesheet">
    </head>

    <body>
        <h1>Members Only</h1>
        <% if (locals.user) {%>
            <h1>WELCOME BACK <%= user.username %></h1>
            <a href="/log-out">LOG OUT</a>
        <% } else { %>
            <form action="/sign-up" method="GET">
                <button>Sign Up</button>
            </form>
        <%}%>
    </body>
</html>