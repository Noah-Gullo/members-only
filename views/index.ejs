<!DOCTYPE html>

<html>
    <head>
        <title>Members Only</title>
        <link href="/styles.css" rel="stylesheet">
    </head>

    <body>
        <h1>Members Only</h1>
        <% if (locals.user) {%>
            <h2>Welcome <%= user.first_name %> <%= user.last_name %></h2>
            <% if (user.member_status == 'user') {%>
                <form action="join-member" method="GET">
                    <button>Become a member</button>
                </form>
            <%} else if(user.member_status == 'member' && user.admin == false) {%>
                <form action="new-admin" method="GET">
                    <button>Become an admin</button>
                </form>
            <%}%>
            <form action="new-message" method="GET">
                    <button>New Message</button>
            </form>
            <a href="/log-out">Log Out</a>
        <% } else { %>
            <form action="/login" method="GET">
                <button>Log In</button>
            </form>
            <form action="/sign-up" method="GET">
                <button>Sign Up</button>
            </form>
        <%}%>

        <% messages.forEach((message) => { %>
            <div class="message">
                <h2 class="messageTitle"><%= message.title %></h2>
                <p> <%= message.text %> </p>
                <% if (locals.user) {%>
                    <% if (user.member_status == 'member') {%>
                        <p>By: <%= message.first_name %> <%= message.last_name %> </p>
                        <p>Sent On: <%= message.timestamp %>
                    <%}%>

                    <% if (user.admin == true) {%>
                        <form action="/delete/<%= message.id %>" method="POST">
                            <button class="deleteButton">Delete Message</button>    
                        </form>
                    <%}%>
                <%}%>
            </div>
        <% }) %>
    </body>
</html>